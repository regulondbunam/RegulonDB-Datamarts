{
    "geneCoexpressions": {
          "validator": {
              "$jsonSchema": {
                  "bsonType": "object",
                  "required": [
                      "gene"
                  ],
                  "properties": {
                    "_id":{
                        "bsonType": "objectId"
                    },
                    "gene": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "_id": {
                                    "type": ["string", "null"]
                                },
                                "name": {
                                    "type": ["string", "null"]
                                },
                                "locusTag": {
                                    "type": ["string", "null"]
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "organisms": {
                        "type": "object",
                        "properties":{
                            "_id": {
                                "type": ["string", "null"]
                            },
                            "name": {
                                "type": ["string", "null"]
                            }
                        },
                        "additionalProperties": false
                    },
                    "rank": {
                        "type": ["number", "null"]
                    },
                    "rgbColor": {
                      "type": ["string", "null"]
                    }
                  },
                  "additionalProperties": false
              }
          },
          "validationLevel": "strict",
          "validationAction": "error"
      }
}