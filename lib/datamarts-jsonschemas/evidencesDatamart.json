{
	"evidencesDatamart": {
		"validator": {
			"$jsonSchema": {
				"type": "object",
				"required": [
					"_id",
					"code",
                    "name"
				],
				"properties": {
                    "_id": {
                        "type": "string",
						"pattern": "^RDB[A-Z0-9_]{5}[A-Z]{3}[0-9A-Z]{5}$"
                    },
                    "category": {
                        "type": ["string", "null"]
                    },
                    "code": {
                        "type": ["string", "null"]
                    },
                    "codeRule": {
                        "type": ["number", "null"]
                    },
                    "name": {
                        "type": ["string", "null"]
                    },
                    "note": {
                        "type": ["string", "null"]
                    },
                    "pertainsTo": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                            "type": ["string", "null"]
                        }
                    },
                    "superClassOf": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                            "type": ["string", "null"]
                        }
                    },
                    "type": {
                        "type": ["string", "null"]
                    }
                },
				"additionalProperties": false
			}
		},
		"validationLevel": "strict",
		"validationAction": "error"
	}
}